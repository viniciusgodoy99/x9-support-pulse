{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "none"
  },
  "mcp": {
    "server": {
      "name": "x9-mcp",
      "version": "0.1.0",
      "title": "X9 do Atendimento — MCP"
    },
    "tools": [
      {
        "name": "ping",
        "title": "Ping",
        "description": "Verifica se o servidor MCP do X9 está online. Retorna 'pong' e o horário do servidor.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "message": {
              "type": "string",
              "description": "Mensagem opcional a ser ecoada de volta."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "atendimento_cliente",
        "title": "Atendimento do cliente",
        "description": "Retorna as demandas e métricas de atendimento (abertas, resolvidas, tempo de resposta, SLA) de um cliente, a partir dos grupos monitorados pelo X9.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "cliente": {
              "type": "string",
              "description": "Nome do cliente (casar com o nome do grupo/cliente, case-insensitive e parcial)."
            },
            "since": {
              "type": "string",
              "description": "Data inicial YYYY-MM-DD (opcional)."
            },
            "until": {
              "type": "string",
              "description": "Data final YYYY-MM-DD (opcional)."
            }
          },
          "required": [
            "cliente"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
